rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if true;
    }

    match /recommendations/{recId} {
      allow read: if true;
      allow write: if true;
    }

    match /leads/{leadId} {
      allow read: if true;
      allow write: if true;
    }

    match /chatMessages/{messageId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
