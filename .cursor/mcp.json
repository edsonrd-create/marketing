{
  "mcpServers": {
    "marketing-brain-google-ads": {
      "command": "node",
      "args": ["${workspaceFolder}/mcp-google-ads/dist/index.js"],
      "env": {
        "MCP_STDIO_SAFE": "true",
        "GOOGLE_ADS_CLIENT_ID": "dev-client-id",
        "GOOGLE_ADS_CLIENT_SECRET": "dev-client-secret",
        "GOOGLE_ADS_REFRESH_TOKEN": "dev-refresh-token",
        "GOOGLE_ADS_DEVELOPER_TOKEN": "dev-developer-token",
        "GOOGLE_ADS_CUSTOMER_ID": "1234567890",
        "GOOGLE_ADS_SKIP_AUTH_VALIDATE": "true",
        "GOOGLE_ADS_FORCE_MOCK": "true",
        "GOOGLE_ADS_LIVE_AUTH": "0"
      }
    },
    "marketing-brain-meta-ads": {
      "command": "node",
      "args": ["${workspaceFolder}/mcp-meta-ads/dist/index.js"],
      "env": {
        "MCP_STDIO_SAFE": "true",
        "META_ACCESS_TOKEN": "dev-meta-token",
        "META_AD_ACCOUNT_ID": "act_dev",
        "META_SKIP_AUTH_VALIDATE": "true",
        "META_FORCE_MOCK": "true"
      }
    },
    "marketing-brain-whatsapp": {
      "command": "node",
      "args": ["${workspaceFolder}/mcp-whatsapp/dist/server.js"],
      "env": {
        "MCP_STDIO_SAFE": "true",
        "WHATSAPP_TOKEN": "dev-wa-token",
        "WHATSAPP_PHONE_NUMBER_ID": "dev-phone",
        "WHATSAPP_STUB": "true",
        "WHATSAPP_VERIFY_TOKEN": "test-verify-token"
      }
    },
    "marketing-brain-insights": {
      "command": "node",
      "args": ["${workspaceFolder}/mcp-insights/dist/server.js"],
      "env": {
        "MCP_STDIO_SAFE": "true",
        "DATABASE_MODE": "memory"
      }
    },
    "marketing-brain-ai-agent": {
      "command": "node",
      "args": ["${workspaceFolder}/mcp-ai-agent/dist/server.js"],
      "env": {
        "MCP_STDIO_SAFE": "true",
        "DATABASE_MODE": "memory"
      }
    },
    "marketing-brain-workflows": {
      "command": "node",
      "args": ["${workspaceFolder}/mcp-workflows/dist/server.js"],
      "env": {
        "MCP_STDIO_SAFE": "true",
        "DATABASE_MODE": "memory"
      }
    }
  }
}
