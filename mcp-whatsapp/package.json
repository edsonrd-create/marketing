{
  "name": "@mcp-marketing/whatsapp",
  "version": "1.1.0",
  "type": "module",
  "description": "Marketing Brain MCP — WhatsApp messaging tools",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-marketing-whatsapp": "./dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mcp-marketing/shared": "1.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
